{
  "name": "PwaniNet",
  "short_name": "PwaniNet",
  "description": "Connect with campus friends, share moments, and stay updated with campus life",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#2563eb",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "categories": ["social", "education", "communication"],
  "splash_pages": [
    {
      "src": "/static/images/splash-640x1136.png",
      "sizes": "640x1136",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/static/images/splash-750x1334.png", 
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/static/images/splash-1125x2436.png",
      "sizes": "1125x2436", 
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/static/images/splash-1242x2208.png",
      "sizes": "1242x2208",
      "type": "image/png", 
      "form_factor": "narrow"
    },
    {
      "src": "/static/images/splash-1536x2048.png",
      "sizes": "1536x2048",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/static/images/splash-1668x2388.png",
      "sizes": "1668x2388",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/static/images/splash-2048x2732.png",
      "sizes": "2048x2732",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "icons": [
    {
      "src": "/static/images/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/images/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/static/images/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "PwaniNet desktop view showing posts and messaging"
    },
    {
      "src": "/static/images/screenshot-mobile.png",
      "sizes": "375x667",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "PwaniNet mobile view showing social feed"
    }
  ],
  "shortcuts": [
    {
      "name": "Messages",
      "short_name": "Chat",
      "description": "Open your conversations",
      "url": "/messaging/",
      "icons": [
        {
          "src": "/static/images/shortcut-messages.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Posts",
      "short_name": "Feed",
      "description": "View campus posts",
      "url": "/posts/",
      "icons": [
        {
          "src": "/static/images/shortcut-posts.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Profile",
      "short_name": "Me",
      "description": "View your profile",
      "url": "/users/profile/",
      "icons": [
        {
          "src": "/static/images/shortcut-profile.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+pwaninet",
      "url": "/handle-protocol/%s"
    }
  ],
  "share_target": {
    "action": "/share/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
