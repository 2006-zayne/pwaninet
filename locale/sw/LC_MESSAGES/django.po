msgid "Back to Settings"
msgstr "Rudi kwenye Mipangilio"

msgid "Appearance"
msgstr "Mwonekano"

msgid "Customize how PwaniNet looks and feels"
msgstr "Badilisha jinsi PwaniNet inavyonekana na kuhisi"

msgid "Theme"
msgstr "Mandhari"

msgid "Light, dark, system preference"
msgstr "Nuru, giza, mapendeleo ya mfumo"

msgid "Light"
msgstr "Nuru"

msgid "Always use the light theme."
msgstr "Tumia daima mandhari ya nuru."

msgid "Dark"
msgstr "Giza"

msgid "Always use the dark theme."
msgstr "Tumia daima mandhari ya giza."

msgid "System"
msgstr "Mfumo"

msgid "Automatically match your device."
msgstr "Lingana kiotomatiki na kifaa chako."

msgid "Language"
msgstr "Lugha"

msgid "Select your preferred language"
msgstr "Chagua lugha unayopendelea"

msgid "English"
msgstr "Kiingereza"

msgid "Use English throughout the application."
msgstr "Tumia Kiingereza katika programu nzima."

msgid "Kiswahili"
msgstr "Kiswahili"

msgid "Tumia Kiswahili kwenye programu nzima."
msgstr "Tumia Kiswahili kwenye programu nzima."

msgid "Typography"
msgstr "Uandishi"

msgid "Font size and readability options"
msgstr "Chaguo za ukubwa wa fonti na usomaji"

msgid "Tiny"
msgstr "Ndogo sana"

msgid "Compact interface."
msgstr "Kiolesura cha kawaida."

msgid "Small"
msgstr "Ndogo"

msgid "Slightly smaller text."
msgstr "Maandishi yanayofura kidogo."

msgid "Medium"
msgstr "Wastani"

msgid "Recommended for most users."
msgstr "Inapendekezwa kwa watumiaji wengi."

msgid "Large"
msgstr "Kubwa"

msgid "Larger text for improved readability."
msgstr "Maandishi makubwa kwa usomaji bora."

msgid "Settings"
msgstr "Mipangilio"

msgid "Profile"
msgstr "Wasifu"

msgid "Manage your profile, username, bio..."
msgstr "Dhibiti wasifu wako, jina la mtumiaji, wasifu..."

msgid "Theme, dark mode, language..."
msgstr "Mandhari, hali ya giza, lugha..."

msgid "Notifications"
msgstr "Arifa"

msgid "Push notifications, mentions..."
msgstr "Arifa za push, matumizi..."

msgid "Privacy & Security"
msgstr "Faragha na Usalama"

msgid "Password, sessions, blocked users..."
msgstr "Nenosiri, vikao, watumiaji waliozuiwa..."

msgid "Storage"
msgstr "Hifadhi"

msgid "Cache, downloads, storage..."
msgstr "Akiba, vipakuliwa, hifadhi..."

msgid "About PwaniNet"
msgstr "Kuhusu PwaniNet"

msgid "Version, support, licenses..."
msgstr "Toleo, msaada, leseni..."

msgid "Manage your profile information and preferences"
msgstr "Dhibiti maelezo ya wasifu wako na mapendeleo"

msgid "Profile Information"
msgstr "Maelezo ya Wasifu"

msgid "Username, display name, bio, avatar"
msgstr "Jina la mtumiaji, jina la kuonyesha, wasifu, picha"

msgid "Profile settings coming soon..."
msgstr "Mipangilio ya wasifu inakuja hivi karibuni..."

msgid "Username, display name, bio, avatar, and more"
msgstr "Jina la mtumiaji, jina la kuonyesha, wasifu, picha, na zaidi"

msgid "Linked Accounts"
msgstr "Akaunti Zilizounganishwa"

msgid "Connected accounts and services"
msgstr "Akaunti na huduma zilizounganishwa"

msgid "Linked accounts coming soon..."
msgstr "Akaunti zilizounganishwa zinakuja hivi karibuni..."

msgid "Choose which notifications you want to receive"
msgstr "Chagua arifa unazotaka kupokea"

msgid "Notification Preferences"
msgstr "Mapendeleo ya Arifa"

msgid "Manage how and when you receive notifications"
msgstr "Dhibiti jinsi na wakati unapopokea arifa"

msgid "Updates"
msgstr "Visasisho"

msgid "Manage application updates and view release information"
msgstr "Dhibiti visasisho vya programu na ona maelezo vya toleo"

msgid "Protect your account and manage your privacy"
msgstr "Linda akaunti yako na dhibiti faragha yako"

msgid "Password"
msgstr "Nenosiri"

msgid "Change your password and security settings"
msgstr "Badilisha nenosiri lako na mipangilio ya usalama"

msgid "Password settings coming soon..."
msgstr "Mipangilio ya nenosiri inakuja hivi karibuni..."

msgid "Active Sessions"
msgstr "Vikao Vya Kazi"

msgid "Manage devices and sessions where you're logged in"
msgstr "Dhibiti vifaa na vikao ambapo umesajiliwa"

msgid "Session management coming soon..."
msgstr "Usimamizi wa vikao unakuja hivi karibuni..."

msgid "Manage your storage and cached data"
msgstr "Dhibiti hifadhi yako na data iliyohifadhiwa"

msgid "Storage Usage"
msgstr "Matumizi ya Hifadhi"

msgid "View your storage usage and manage space"
msgstr "Ona matumizi yako ya hifadhi na dhibiti nafasi"

msgid "Storage usage coming soon..."
msgstr "Matumizi ya hifadhi yana kuja hivi karibuni..."

msgid "Version information and support resources"
msgstr "Maelezo ya toleo na rasilimali za msaada"

msgid "App Information"
msgstr "Maelezo ya Programu"

msgid "Version and build information"
msgstr "Maelezo ya toleo na kujenga"

msgid "Current Version"
msgstr "Toleo la Sasa"

msgid "Build"
msgstr "Jenga"

msgid "Channel"
msgstr "Njia"

msgid "Environment"
msgstr "Mazingira"

msgid "Release Center"
msgstr "Kituo cha Toleo"

msgid "View release notes and update information"
msgstr "Ona maelezo ya toleo na maelezo ya visasisho"

msgid "Current Release Details"
msgstr "Maelezo ya Toleo la Sasa"

msgid "Home"
msgstr "Nyumbani"

msgid "Groups"
msgstr "Vikundi"

msgid "Post"
msgstr "Chapisha"

msgid "Login"
msgstr "Ingia"

msgid "Search friends &amp; groups…"
msgstr "Tafuta marafiki na vikundi…"

msgid "Search friends and groups"
msgstr "Tafuta marafiki na vikundi"

msgid "Clear search"
msgstr "Futa utafutaji"

msgid "What's on your mind?"
msgstr "Unachofikiria?"

msgid "New Post"
msgstr "Chapisho Jipya"

msgid "Create a Post"
msgstr "Unda Chapisho"

msgid "Discard"
msgstr "Tupa"

msgid "Add Attachment"
msgstr "Ongeza Kiambatisho"

msgid "Images"
msgstr "Picha"

msgid "Video"
msgstr "Video"

msgid "PDF"
msgstr "PDF"

msgid "Share to profile"
msgstr "Shiriki kwenye wasifu"

msgid "Report post"
msgstr "Ripoti chapisho"

msgid "Are you sure you want to delete this post?"
msgstr "Una uhakika unataka kufuta chapisho hili?"

msgid "Delete post"
msgstr "Futa chapisho"

msgid "Share"
msgstr "Shiriki"

msgid "Write a comment..."
msgstr "Andika maoni..."

msgid "Add a comment (optional)"
msgstr "Ongeza maoni (hiari)"

msgid "What do you think?"
msgstr "Unafikiria nini?"

msgid "Repost"
msgstr "Chapisha tena"

msgid "Share Post"
msgstr "Shiriki Chapisho"

msgid "Share to Users"
msgstr "Shiriki kwa Watumiaji"

msgid "Share to Groups"
msgstr "Shiriki kwa Vikundi"

msgid "Search users you follow..."
msgstr "Tafuta watumiaji unaofuata..."

msgid "Start typing to search users you follow"
msgstr "Anza kuandika kutafuta watumiaji unaofuata"

msgid "Selected users will appear here"
msgstr "Watumiaji waliochaguliwa wataonekana hapa"

msgid "Add a message (optional)"
msgstr "Ongeza ujumbe (hiari)"

msgid "Check this out!"
msgstr "Angalia hili!"

msgid "Share with selected users"
msgstr "Shiriki na watumiaji waliochaguliwa"

msgid "Search groups you're a member of..."
msgstr "Tafuta vikundi ambavyo ni mwanza..."

msgid "Start typing to search groups"
msgstr "Anza kuandika kutafuta vikundi"

msgid "Selected groups will appear here"
msgstr "Vikundi vilivyochaguliwa vitaonekana hapa"

msgid "Share with selected groups"
msgstr "Shiriki na vikundi vilivyochaguliwa"
