# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=vasto
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5433

# Redis (for caching)
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Pwanimate private generated documents.
# Development falls back to local private storage when this is blank.
# Production with USE_S3=1 requires a separate private R2 bucket; do not use the public CDN bucket.
PWANIMATE_PRIVATE_MEDIA_BUCKET=

# Cloudflare R2 Configuration
# Set USE_S3=1 to enable R2 uploads
# Add your actual R2 credentials here
USE_S3=1
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-r2-bucket-name
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
CDN_DOMAIN=cdn.pwaninet.app

# Development folder prefix - keeps dev uploads separate from production
# Uploads will go to: bucket-name/dev-uploads/
R2_DEV_PREFIX=dev-uploads

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Email Configuration
# For development, use console backend (emails printed to console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, use SMTP backend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@pwaninet.app
SERVER_EMAIL=noreply@pwaninet.app

# Environment mode indicator
ENV_MODE=local

# VAPID keys for Web Push notifications
# Generate these using: python -c "from py_vapid import Vapid; v = Vapid(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@pwaninet.app

# Firebase Admin SDK credentials for Native Push (FCM)
# Download service account JSON from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json

# Pwanimate Configuration
PWANIMATE_ENABLED=True
# Optional public web search. Leave provider keys blank to keep web search unavailable.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER_ORDER=tavily,brave,serper
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=5
PWANIMATE_GEMINI_API_KEY=
PWANIMATE_GROQ_API_KEY=
PWANIMATE_SPEECH_TO_TEXT_MODEL=whisper-large-v3-turbo
PWANIMATE_SPEECH_TO_TEXT_TIMEOUT=60
PWANIMATE_VOICE_MAX_BYTES=26214400
PWANIMATE_OPENROUTER_API_KEY=
PWANIMATE_EMBEDDING_PROVIDER=gemini
PWANIMATE_EMBEDDING_MODEL=gemini-embedding-2
PWANIMATE_EMBEDDING_DIMENSIONS=768
PWANIMATE_EMBEDDING_BATCH_SIZE=32

# Self-hosted spark-vector worker (docs/local-models-design.md §4-§5).
# Cutover: set PWANIMATE_EMBEDDING_PROVIDER=selfhosted (runbook §6).
PWANIMATE_SELFHOSTED_EMBEDDINGS_URL=http://spark_vector:8100/v1/embeddings
PWANIMATE_SELFHOSTED_EMBEDDINGS_MODEL=multilingual-e5-base
PWANIMATE_SELFHOSTED_EMBEDDINGS_TIMEOUT=10
PWANIMATE_SELFHOSTED_EMBEDDINGS_TOKEN=
# Texts per HTTP request to the worker: small batches keep the single
# inference slot free for interactive queries (§4 operating model).
PWANIMATE_SELFHOSTED_EMBEDDING_BATCH_SIZE=4
# spark-vector container settings (docker-compose.prod.yml)
SPARK_VECTOR_MODEL_NAME=multilingual-e5-base
SPARK_VECTOR_EXPECTED_DIMENSIONS=768
SPARK_VECTOR_TOKEN=
# One inference slot; interactive queries are admitted ahead of bulk batches.
SPARK_VECTOR_INFER_CONCURRENCY=1
# Per-request token budget (over-budget requests are refused with 413).
SPARK_VECTOR_MAX_TOKENS_PER_REQUEST=4096
# Backlog cap (above this the worker answers 503 + Retry-After).
SPARK_VECTOR_MAX_WAITERS=32

# Multi-Provider Embedding Configuration (Preparation)
PWANIMATE_JINA_API_KEY=
PWANIMATE_JINA_MODEL=jina-embeddings-v3

PWANIMATE_VOYAGE_API_KEY=
PWANIMATE_VOYAGE_MODEL=voyage-3

PWANIMATE_CLOUDFLARE_API_TOKEN=
PWANIMATE_CLOUDFLARE_ACCOUNT_ID=
PWANIMATE_CLOUDFLARE_MODEL=@cf/baai/bge-base-en-v1.5
PWANIMATE_DEFAULT_LLM_PROVIDER=gemini
PWANIMATE_GEMINI_MODEL=gemini-3.8-flash
PWANIMATE_GROQ_MODEL=openai/gpt-oss-120b
PWANIMATE_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Google Sign-In (website, Google Identity Services ID-token flow)
# Create a Web OAuth client in Google Cloud Console; no client secret needed.
# Leave GOOGLE_WEB_CLIENT_ID blank to hide the Google button.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ALLOWED_HD=
GOOGLE_JWKS_CACHE_TIMEOUT=3600
GOOGLE_LOGIN_ENABLED=True
# Fixed-window rate limit for POST /users/google/complete/ (attempts per IP per window in seconds)
GOOGLE_COMPLETE_RATELIMIT_ATTEMPTS=20
GOOGLE_COMPLETE_RATELIMIT_WINDOW=300
